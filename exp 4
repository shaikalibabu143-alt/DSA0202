import cv2

# Read image
img = cv2.imread("image.jpg")

# Bigger image
bigger = cv2.resize(img, None, fx=2, fy=2)

# Smaller image
smaller = cv2.resize(img, None, fx=0.5, fy=0.5)

# Display images
cv2.imshow("Original", img)
cv2.imshow("Bigger", bigger)
cv2.imshow("Smaller", smaller)

cv2.waitKey(0)
cv2.destroyAllWindows()
